{
  "name": "devchat-backend",
  "version": "1.0.0",
  "description": "DevChat backend — Express + Socket.io + PostgreSQL + Redis",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "npx prisma db push --accept-data-loss && npx tsx prisma/seed.ts && node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:sqlite": "copy prisma\\schema.sqlite.prisma prisma\\schema.prisma && prisma db push --force-reset && prisma db seed",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:backup": "tsx prisma/backup.ts"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.5.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.5",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "prisma": "^6.5.0",
    "rate-limit-redis": "^4.2.0",
    "socket.io": "^4.8.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "vitest": "^3.0.7"
  }
}
